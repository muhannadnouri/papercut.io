# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

public/*
!public/fonts/
!public/fonts/reader/
!public/fonts/reader/**
.cache/*

# Downloaded local TTS assets are large and platform-specific.
src-tauri/tts/runtime/*

# Sidecar source is tracked; local Python envs, caches, model files, and probes are not.
sidecars/**/.venv/
sidecars/**/__pycache__/
sidecars/**/.pytest_cache/
sidecars/**/models/
sidecars/**/runtime/
sidecars/**/*.wav

private_keys/

# Apple signing/provisioning secrets.
*.cer
*.certSigningRequest
*.key
*.p12
*.p8
*.mobileprovision
*.provisionprofile
