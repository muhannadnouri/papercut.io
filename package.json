{
  "name": "papercut.io",
  "private": true,
  "version": "1.10.2",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:pdf-assets && vite",
    "tauri": "tauri",
    "tauri:dev": "node scripts/desktop/dev-desktop.js",
    "test:search-eval": "node scripts/search/search-eval.mjs",
    "build": "npm run check:i18n && npm run build:typecheck && npm run build:vite && npm run build:search-index",
    "check:i18n": "node scripts/checks/check-i18n.mjs",
    "build:typecheck": "tsc -b",
    "build:vite": "npm run prepare:pdf-assets && vite build",
    "build:search-index": "node scripts/search/build-search-index.js",
    "browser": "npm run build && vite preview",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint --max-warnings=0",
    "test:lint-policy": "node --test scripts/checks/__tests__/check-lint-policy-selftest.mjs",
    "desktop": "node scripts/desktop/build-desktop.js",
    "desktop:static": "node scripts/desktop/build-desktop.js --static",
    "prepare:silma-sidecar": "node scripts/silma/prepare-silma-sidecar.js",
    "test:pdf-extraction": "node scripts/pdf/__tests__/check-pdf-extraction.mjs scripts/fixtures/pdf/extraction-inline-columns.pdf",
    "prepare:pdf-boundary-fixtures": "node scripts/pdf/prepare-pdf-boundary-fixtures.mjs",
    "package:silma-runtime": "node scripts/silma/package-silma-runtime-pack.js",
    "install:silma-cuda-runtime": "bash scripts/silma/install-silma-cuda-runtime.sh",
    "verify:appimage-media": "node scripts/desktop/verify-appimage-media.js",
    "android:apk": "node scripts/android/build-android.js",
    "android:apk:native-tts": "node scripts/android/build-android.js --native-tts",
    "android:apk:release": "node scripts/android/build-android.js --native-tts --production",
    "prepare:license-notices": "node scripts/android/prepare-license-notices.js",
    "prepare:source-archive": "node scripts/android/assemble-source-archive.js",
    "check:android-reproducibility": "node scripts/android/check-build-reproducibility.js",
    "prepare:jdk": "node scripts/android/prepare-local-jdk.js",
    "prepare:jdk:force": "node scripts/android/prepare-local-jdk.js --force",
    "prepare:pdf-assets": "node scripts/pdf/prepare-pdf-assets.js",
    "prepare:sherpa-android-libs": "node scripts/android/prepare-sherpa-android-libs.js",
    "prepare:sherpa-android-libs:force": "node scripts/android/prepare-sherpa-android-libs.js --force",
    "ios:init": "node scripts/ios/build-ios.js --init",
    "ios:ipa": "node scripts/ios/build-ios.js",
    "ios:ipa:native-tts": "node scripts/ios/build-ios.js --native-tts",
    "ios:ci": "node scripts/ios/build-ios.js --ci-check",
    "prepare:sherpa-ios-libs": "node scripts/ios/prepare-sherpa-ios-libs.js",
    "prepare:sherpa-ios-libs:force": "node scripts/ios/prepare-sherpa-ios-libs.js --force",
    "ios:ci:device": "node scripts/ios/check-ios-device-build.js"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "2.5.3",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "i18next": "^26.3.6",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.10",
    "tauri-plugin-native-audio-api": "1.0.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import-newlines": "1.4.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "29.1.1",
    "pagefind": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
