{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Papercut",
  "version": "1.9.0",
  "identifier": "io.papercut.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Papercut",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/document_uploads/*/source.pdf",
          "$APPDATA/document_uploads/*/assets/*"
        ]
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
        "Cross-Origin-Resource-Policy": "same-origin"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["html", "htm"],
        "name": "HTML document",
        "description": "HTML document",
        "mimeType": "text/html",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["epub"],
        "contentTypes": ["org.idpf.epub-container"],
        "name": "EPUB book",
        "description": "EPUB book",
        "mimeType": "application/epub+zip",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["txt"],
        "name": "Plain-text document",
        "description": "Plain-text document",
        "mimeType": "text/plain",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["md", "markdown"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate",
        "androidIntentActionFilters": ["view"]
      }
    ]
  }
}
